{
    # Мобильные операторы часто режут/ломают UDP (QUIC) — HTTP/3 отключён.
    # Иначе вебвью MAX, закэшировавший h3 через Alt-Svc, виснет на QUIC
    # по мобильному интернету и показывает «Техническую заминку».
    servers {
        protocols h1 h2
    }
}

procityservice.ru {
    # Доступные логи: видно IP, путь и статус — диагностика «не работает
    # с телефона» (раньше запросы были неотличимы от молчания)
    log

    # Сжатие: бандл ~1.3 МБ по мобильной сети качался десятки секунд и
    # вебвью успевал показать «Техническую заминку». Тайлы (Range/PMTiles)
    # не трогаем — им сжатие только мешает.
    @notiles not path /tiles*
    encode @notiles gzip

    # Хэшированные ассеты (в имени хэш контента) кэшируем навсегда:
    # после подтверждения номера AuthGate делает reload(), а из-за no-store
    # весь 1.3-МБ бандл качался ЗАНОВО — приложение «висло» после логина.
    @immutable path /client/assets/* /executor/assets/* /admin/assets/* /assets*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    # WebAppData живёт в URL/хэше; никакого стороннего кэша
    # Веб-вью MAX кэширует index.html без cache-control: миниапп мог жить
    # на старом бандле (например, без загрузки списка заказов) неделями.
    # Всё, кроме тайлов OSM и хэшированных ассетов, — без локального кэша.
    @nocache not path /tiles* /client/assets/* /executor/assets/* /admin/assets/* /assets*
    header @nocache Cache-Control "no-store"

    # Телефоны с закэшированным h3 сразу очищают альтернативу
    header Alt-Svc "clear"

    handle /api/* {
        reverse_proxy api:8000
    }

    # Миниапп клиента (новый путь)
    handle /client* {
        uri strip_prefix /client
        reverse_proxy client:80
    }

    # Миниапп исполнителя (новый путь)
    handle /executor* {
        uri strip_prefix /executor
        reverse_proxy executor:80
    }

    # Легаси-алиасы старых путей (старые вебаппы в MAX, закэшированные ссылки)
    handle /passenger* {
        uri strip_prefix /passenger
        reverse_proxy client:80
    }

    handle /driver* {
        uri strip_prefix /driver
        reverse_proxy executor:80
    }

    handle /admin* {
        uri strip_prefix /admin
        reverse_proxy admin:80
    }

    # Векторные тайлы своего OSM-стека (PMTiles, Range поддержан nginx)
    handle /tiles* {
        uri strip_prefix /tiles
        reverse_proxy osm-tiles:80
    }

    handle {
        respond "Pro service is running" 200
    }
}
